NODE_ENV=development
PORT=4000

# Runtime pooled database connection.
DATABASE_URL=postgresql://postgres:password@localhost:5432/lost_and_found
# Direct database connection used by Prisma migrations.
DIRECT_URL=postgresql://postgres:password@localhost:5432/lost_and_found

JWT_SECRET=replace-with-at-least-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

CORS_ORIGIN=http://localhost:3000
COOKIE_NAME=lost_found_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Optional: registering this email bootstraps the first super admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=

# S3-compatible object storage (Cloudflare R2, S3, etc.) for report images.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=
